APP_NAME=Rapor Asistan
APP_TAGLINE=Trainable Text-to-SQL reporting cockpit
ASSISTANT_NAME=Rapor-AI
APP_VERSION=4.2.0

# demo = bundled SQLite (clone and ask)
# generic = your own database via the setup wizard
ACTIVE_PACK=demo
DB_BACKEND=sqlite
SQL_DIALECT=sqlite

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# Used only when ACTIVE_PACK=generic and DB_BACKEND=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
DEFAULT_DATABASE=
DEFAULT_FIRM=MAIN

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Admin
